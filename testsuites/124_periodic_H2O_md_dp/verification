#!/usr/bin/env python 

# This verification script file is automatically executed after the SALMON. 
# If necessary, this script file can used for the verification of the result. 
# The script MUST indicate a "return-code 0", if the calculation is successful. 
# If a negative value is returned, it is treated as a test failure. 
 
import sys 
import os 
import re 

print("#" * 60) 
print("# Verification start") 

filelist = [ 
    "H2O_rt_energy.data", 
    "H2O_rt.data",
] 

checklist = { 
    # Eall
    "Eall": [
        -100, # Temporary value for result
        -0.466289445223927E+003,  # Reference value 
        1e-6,  # Permissible error 
    ], 
} 

print("# Checking the existance of outputfile") 
for item in filelist: 
    if not os.path.exists(item): 
        print("File not found: %s" % item) 
        sys.exit(-1)  # Failure 

print("# Checking calculated result")
result = {}
linecount = 0
for line in open("H2O_rt_energy.data"):
    linecount += 1
    if linecount == 108: # corresponds to line 108
        for name, [resval, refval, error] in checklist.items(): 
            data = line.split()
            result[name] = float(data[1])
            print(result[name])

for name, [resval, refval, error] in checklist.items():
    if name not in result: 
        print("Result %s is not found" % name) 
        sys.exit(-1)  # Failure 
    else:
        print("Result %s = %e (Reference = %e)" % (name, result[name], refval)) 
        if not (abs(result[name] - refval) <= error): 
            print("Mismatch |%e - %e| > %e)" % (result[name], refval, error)) 
            sys.exit(-1)  # Failure 

# Electron current Jm at the last step (t = 0.25 fs), after 19 projector
# updates (step_update_ps = 50). Reference: develop CPU build; CPU and GPU
# builds and r-space/orbital layouts agree within 1e-11.
current_ref = {
    "Jm_x": [13,  0.157166188934894E-003],
    "Jm_y": [14, -0.984441482496257E-004],
    "Jm_z": [15, -0.498432449985847E-004],
}
current_err = 1e-8

last = None
for line in open("H2O_rt.data"):
    if line.strip() and not line.lstrip().startswith("#"):
        last = line.split()
if last is None or abs(float(last[0]) - 0.25) > 1e-6:
    print("Last step of H2O_rt.data not found")
    sys.exit(-1)  # Failure
for name, [col, refval] in current_ref.items():
    val = float(last[col])
    print("Result %s = %e (Reference = %e)" % (name, val, refval))
    if not (abs(val - refval) <= current_err):
        print("Mismatch |%e - %e| > %e)" % (val, refval, current_err))
        sys.exit(-1)  # Failure

print("# Verification end") 
print("#" * 60) 

sys.exit(0)  # Success 
